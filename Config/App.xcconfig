#include "Base.xcconfig"

PRODUCT_NAME = VNReader
PRODUCT_BUNDLE_IDENTIFIER = $(VN_BUNDLE_ID)
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS = VN_MACCATALYST=0
INFOPLIST_PREPROCESSOR_DEFINITIONS[sdk=macosx*] = VN_MACCATALYST=1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = VN Reader
// Strings are authored in zh-Hant, but system languages without a translation fall back to English.
DEVELOPMENT_LANGUAGE = en
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.books
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=macosx*] = NO
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
// iPad receives an Inbox copy; Mac receives a security-scoped original URL,
// which ImportCoordinator copies into the library without changing the source.
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = NO
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=macosx*] = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
// The share sheet's Save Image needs this; without it, choosing Save Image can crash the app.
// Translations are in App/Resources/InfoPlist.xcstrings.
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = Lets you save comic pages to Photos from the share sheet.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_APP_SANDBOX = NO
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/MacCatalyst.entitlements
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks

// Build 7: CloudKit sync. Export changes the container environment for TestFlight.
ICLOUD_CONTAINER_ENVIRONMENT = Development
CODE_SIGN_ENTITLEMENTS = Config/iCloud.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/MacCatalyst.entitlements
