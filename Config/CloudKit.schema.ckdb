DEFINE SCHEMA

    RECORD TYPE Book (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        cover           ASSET,
        manifest        ASSET,
        payload         BYTES QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE BookFile (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        archive         ASSET,
        contentID       STRING QUERYABLE SEARCHABLE SORTABLE,
        size            INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
