          "stringUnit" : {
            "state" : "translated",
            "value" : "共有シートから漫画のページを写真に保存できるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你从共享菜单将漫画页面存储到照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓你從分享選單將漫畫頁面儲存到照片。"
          }
        }
