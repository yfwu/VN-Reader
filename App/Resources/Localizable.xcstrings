    "error.corrupt.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive couldn’t be parsed (%@). Check the file with an archive utility on a computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブを解析できませんでした（%@）。コンピュータの解凍ソフトでファイルが正常か確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法解析压缩包（%@）。请在电脑上用解压缩程序确认文件是否正常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法解析壓縮檔（%@）。請在電腦上用解壓縮程式確認檔案是否正常。"
          }
        }
      }
    },
    "error.corrupt.title" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
