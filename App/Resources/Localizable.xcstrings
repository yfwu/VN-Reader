    "book.delete.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the app’s copy, reading progress and cache are deleted. Your original file isn’t affected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されるのは App 内のコピー、読書の進捗、キャッシュのみです。元のファイルには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会删除 App 内的副本、阅读进度与缓存，不会影响你原本的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會刪除 App 內的副本、閱讀進度與快取，不會影響你原本的檔案。"
          }
        }
      }
    },
