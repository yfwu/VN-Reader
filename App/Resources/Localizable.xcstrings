        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file doesn’t start with a ZIP or RAR signature, so its contents can’t be identified (the file extension isn’t trusted). Make sure the file is a CBZ or CBR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの先頭に ZIP または RAR の識別子がないため、内容を判別できません（拡張子は判定に使いません）。CBZ または CBR ファイルであることを確認してください。"
          }
