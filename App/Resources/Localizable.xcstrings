    "error.truncated.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive ends earlier than it should, usually because a download or copy didn’t finish. Download the complete file again, then import it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブが本来の終端より前で途切れています。多くの場合、ダウンロードやコピーが完了していないことが原因です。完全なファイルを再ダウンロードしてから読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩包在应有的结尾之前就中断了，通常是下载未完成或复制中断。请重新下载完整文件后再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
