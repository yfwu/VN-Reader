            "value" : "壓縮檔結構錯誤"
          }
        }
      }
    },
    "error.dict.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This RAR uses a compression dictionary larger than 4 GB. Extracting it on iPad could run out of memory, so it isn’t supported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この RAR は 4 GB を超える圧縮辞書を使用しています。iPad で展開するとメモリが不足するおそれがあるため、対応していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 RAR 使用超过 4 GB 的压缩字典，在 iPad 上解压可能耗尽内存，因此不支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 RAR 使用超過 4 GB 的壓縮字典，在 iPad 上解壓可能耗盡記憶體，因此不支援。"
          }
        }
      }
