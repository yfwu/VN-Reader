    "error.checksum.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After extraction, the checksum of “%@” doesn’t match the one recorded in the archive. This data is damaged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の展開後のチェックサムがアーカイブの記録と一致しません。このデータは破損しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”解压后的校验值与压缩包记录不一致，这部分数据已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」解壓後的檢查碼與壓縮檔記錄不一致，這部分資料已損壞。"
          }
        }
      }
    },
    "error.checksum.title" : {
      "extractionState" : "extracted_with_value",
