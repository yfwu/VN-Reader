    "settings.defaults.footer" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each book keeps its own settings; these only apply to books you import later. Books whose ComicInfo.xml marks them as manga read right to left automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定は本ごとに保存されます。ここでの設定は今後読み込む本にのみ適用されます。ComicInfo.xml でマンガと指定されている本は、自動的に右から左で表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每本书的设置会分别保存；这里只影响之后导入的书。含 ComicInfo.xml 且标示为日漫的书会自动使用从右到左。"
          }
        },
        "zh-Hant" : {
