    "error.unreadable.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to the source location was denied or reading was interrupted (%@). Make sure the file has been downloaded to this device and any network drive is still connected, or first copy it to “On My iPad” in the Files app, then import it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の場所へのアクセスが拒否されたか、読み込みが中断されました（%@）。ファイルがこのデバイスにダウンロード済みか、ネットワークドライブが接続されたままかを確認するか、先に「ファイル」App で「このiPad内」にコピーしてから読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "源位置拒绝访问或读取中断（%@）。请确认文件已下载到设备、网络磁盘仍处于连接状态，或先在“文件”App 中将其拷贝到“我的 iPad”再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來源位置拒絕存取或讀取中斷（%@）。請確認檔案已下載到裝置、網路磁碟仍連線，或先在「檔案」App 中把它拷貝到「我的 iPad」再匯入。"
          }
        }
      }
    },
