        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存包含缩略图与 solid RAR 的解压页面，清除后会在需要时重新生成，不影响书籍与阅读进度。"
          }
        },
        "zh-Hant" : {
